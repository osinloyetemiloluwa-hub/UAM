<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Loopback socket for the local MCP server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The ONLY runtime permission the app declares. It is granted exclusively by the
         Android system dialog surfaced by DeviceAskActivity — never by the agent. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:allowBackup="false"
        android:label="NanoMuse Device Host"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent, dialog-hosting gate. No custom permission UI here: the only
             interactive element is the real system permission dialog. -->
        <activity
            android:name=".DeviceAskActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="dev.nanomuse.devicehost.ask" />

        <service
            android:name=".McpServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
